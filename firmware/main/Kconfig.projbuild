menu "CamBox"

    choice CAM_DRIVE
        prompt "Drive type"
        default CAM_DRIVE_MG90S
        help
            Which motor this box drives. Both build from the same firmware;
            only the motor output differs (servo.c or motor_drv8833.c).

        config CAM_DRIVE_MG90S
            bool "MG90S continuous servo"
        config CAM_DRIVE_N20
            bool "N20 gearmotor + DRV8833"
    endchoice

    choice CAM_BOARD
        prompt "Board"
        default CAM_BOARD_XIAO_C6
        help
            Which ESP32-C6 board is fitted. Only the pin map (main/board.h)
            and the antenna set-up differ.

        config CAM_BOARD_XIAO_C6
            bool "Seeed XIAO ESP32-C6"
        config CAM_BOARD_SUPERMINI_C6
            bool "ESP32-C6 Super Mini (26 x 18 mm, castellated)"
    endchoice

endmenu
